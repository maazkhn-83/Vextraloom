# Copy to .env for local use. On Replit, add these in the Secrets panel instead.

# MongoDB connection string (MongoDB Atlas works well). If missing/unreachable, emails still send.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vextraloom?retryWrites=true&w=majority

# Gmail account that SENDS the notification email, plus a Google "App Password" (16 chars, 2-Step Verification required)
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact-form messages are delivered
EMAIL_TO=vextraloomhello@gmail.com

# Port the Express server listens on (dev default 3001). Do not use 5173 (Vite).
PORT=3001

# Optional: comma-separated origins allowed by CORS if the frontend is hosted on a different domain
# CLIENT_ORIGIN=https://www.example.com
